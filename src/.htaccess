# ============================================================
#  OneHealth — Frontend Angular (SPA) + Service Worker (PWA)
#  Apache / LiteSpeed (cPanel)
# ============================================================

# ------------------------------------------------------------
#  1) Routing SPA : toute route inconnue -> index.html
#     (sinon /tabs/alerts/123 renvoie une 404 en rechargeant)
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------
  #  Robots sociaux (WhatsApp, Facebook, X/Twitter, LinkedIn,
  #  Telegram…) : ils n'exécutent pas le JavaScript d'Angular,
  #  donc aucune balise Open Graph côté SPA. On les redirige
  #  vers le renderer NestJS par proxy interne. Le crawler recoit
  #  directement un HTML 200 sous l'URL frontend.
  # ----------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|viber|vkshare) [NC]
  RewriteRule ^posts/([0-9a-fA-F]{24})/?$ http://127.0.0.1:3000/api/share/post/$1 [P,L,NE,E=Proxy-Host:backend.onehealthnetwork.yaba-in.com]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|viber|vkshare) [NC]
  RewriteRule ^profils/([0-9a-fA-F]{24})/?$ http://127.0.0.1:3000/api/share/profile/$1 [P,L,NE,E=Proxy-Host:backend.onehealthnetwork.yaba-in.com]

  # Compatibilite des liens historiques /post-detail?id=...
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|pinterest|skypeuripreview|viber|vkshare) [NC]
  RewriteCond %{THE_REQUEST} "\s/+post-detail\?id=([0-9a-fA-F]{24})" [NC]
  RewriteRule ^post-detail http://127.0.0.1:3000/api/share/post/%1 [P,L,NE,E=Proxy-Host:backend.onehealthnetwork.yaba-in.com]

  # Laisser passer les fichiers et dossiers RÉELS (js, css, images, assets…)
  # seulement APRES les routes sociales.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste -> index.html (Angular Router prend le relais)
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------
#  2) NE JAMAIS mettre en cache le manifeste du Service Worker
#     ni index.html. C'est CE qui permet de détecter un nouveau
#     déploiement immédiatement (puis AppUpdateService rafraîchit).
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://backend.onehealthnetwork.yaba-in.com; connect-src 'self' https://backend.onehealthnetwork.yaba-in.com https://accounts.google.com https://fonts.gstatic.com https://firebasestorage.googleapis.com https://tile.openstreetmap.org; frame-src https://accounts.google.com https://docs.google.com https://view.officeapps.live.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"

  <FilesMatch "^(ngsw\.json|ngsw-worker\.js|onehealth-sw\.js|safety-worker\.js|worker-basic\.min\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
#  3) Cache long pour les fichiers HASHÉS (leur nom change à
#     chaque build : main.<hash>.js, styles.<hash>.css, …)
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
#  4) Compression (gain de poids au chargement)
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  5) (Optionnel) Forcer HTTPS — décommente SEULEMENT si cPanel
#     ne le fait pas déjà (sinon risque de boucle de redirection).
# ------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
